PORT=3000
# Leave empty to use the persistent local database under Server/data/embedded-mongodb.
# Set this to a MongoDB connection string for shared/production storage.
MONGODB_URI=
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Shared phone/password accounts created idempotently on server startup.
# Keep real passwords only in the ignored Server/.env file.
ENABLE_TEST_ACCOUNTS=false
TEST_ACCOUNT_PHONE=19900000001
TEST_ACCOUNT_PASSWORD=replace-with-a-long-random-password
PREMIUM_ACCOUNT_PHONE=19900000002
PREMIUM_ACCOUNT_PASSWORD=replace-with-a-different-long-random-password

# Legacy single-account switch remains supported.
ENABLE_TEST_ACCOUNT=false

# 防沉迷（阶段2 正式接入国家系统后填写；阶段1 mock 不需要）
ANTIFRAUD_NATIONAL_API_URL=
ANTIFRAUD_APP_ID=
ANTIFRAUD_APP_KEY=
ANTIFRAUD_ENABLED=false

# QQ OAuth
QQ_APP_ID=YOUR_QQ_APP_ID
QQ_APP_KEY=YOUR_QQ_APP_KEY

# WeChat OAuth
WECHAT_APP_ID=YOUR_WECHAT_APP_ID
WECHAT_APP_SECRET=YOUR_WECHAT_APP_SECRET

# 微信支付 API v3（App 支付）
WECHAT_PAY_APP_ID=YOUR_WECHAT_OPEN_APP_ID
WECHAT_PAY_MCH_ID=YOUR_WECHAT_MERCHANT_ID
WECHAT_PAY_SERIAL_NO=YOUR_MERCHANT_CERT_SERIAL_NO
WECHAT_PAY_PRIVATE_KEY_PATH=/secure/apiclient_key.pem
# 32 字节 APIv3 密钥（不要提交到代码仓库）
WECHAT_PAY_API_V3_KEY=YOUR_32_BYTE_API_V3_KEY
WECHAT_PAY_PLATFORM_CERT_PATH=/secure/wechatpay_platform_cert.pem
WECHAT_PAY_PLATFORM_CERT_SERIAL=YOUR_PLATFORM_CERT_SERIAL

# 支付宝 App 支付（RSA2）
ALIPAY_APP_ID=YOUR_ALIPAY_APP_ID
ALIPAY_PRIVATE_KEY_PATH=/secure/app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=/secure/alipay_public_key.pem

# 必须是支付平台可访问的 HTTPS 域名，末尾不要加斜杠
PAYMENT_NOTIFY_BASE_URL=https://api.example.com

# SMS service (Tencent Cloud SMS example)
SMS_SECRET_ID=YOUR_SMS_SECRET_ID
SMS_SECRET_KEY=YOUR_SMS_SECRET_KEY
SMS_SDK_APP_ID=YOUR_SMS_SDK_APP_ID
SMS_TEMPLATE_ID=YOUR_SMS_TEMPLATE_ID
SMS_SIGN_NAME=TreeSetup
